# SafePrompt Backend Environment Template
# Copy this file to backend/.env and insert your real credentials.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
VAULT_KEY=your_64_character_hex_key_here
AUTH_SECRET_KEY=your_64_character_hex_auth_secret_key_here
INITIAL_ADMIN_PASSWORD=your_initial_admin_password_here
INITIAL_HR_PASSWORD=your_initial_hr_password_here
INITIAL_EMPLOYEE_PASSWORD=your_initial_employee_password_here
